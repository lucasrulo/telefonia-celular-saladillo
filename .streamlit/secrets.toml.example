# Copiá este archivo como .streamlit/secrets.toml (local) o pegá el contenido en
# Streamlit Cloud > App > Settings > Secrets

# Repo PRIVADO de GitHub donde se guardan los datos en CSV (distinto del repo de la app)
DATA_REPO = "lucasrulo/telefonia-celular-saladillo-datos"
# Token fine-grained con permiso "Contents: Read and write" SOLO sobre ese repo
GITHUB_TOKEN = "github_pat_xxxxxxxxxxxxxxxx"

# Clave de acceso a la app (opcional). Si no lo definís, entra sin clave.
APP_PASSWORD = "cambiame"
